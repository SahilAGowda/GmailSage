GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
DIGEST_TO_EMAIL=you@gmail.com
TRIAGE_QUERY=in:inbox newer_than:2d
TRIAGE_MAX_RESULTS=50
TRIAGE_DB_PATH=triage.db
TRIAGE_LOG_PATH=triage.log.jsonl
DIGEST_HOURS=24
# Optional free offline fallback when Groq is down/rate-limited: install Ollama, then `ollama pull qwen2.5:3b`
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
